# Copy this file to .env.docker and fill in values locally.
# Never commit .env.docker or use a real token in this example file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DISCORD_TOKEN=

GITHUB_ASSET_OWNER=jaredv2
GITHUB_ASSET_REPO=zeta-cdn
GITHUB_ASSET_TAG=zeta-assets-v1
GITHUB_ASSET_READ_TOKEN=

# Shared database TLS settings: DB_SSL_MODE is read by the API,
# DB_SSL is read by the Discord bot.
DB_SSL_MODE=require
DB_SSL=require

# Bot settings
AUTO_MIGRATE=true
SYNC_COMMANDS=true
DEBUG_PRINTS=false
REQUIRE_VERIFIED=true
REGEN_COOLDOWN_HOURS=24
ADMIN_ROLE_IDS=
DEV_GUILD_ID=

# API settings
AUTH_CACHE_TTL=30
CORS_ORIGINS=*
LOG_LEVEL=INFO
# compose.yml mounts these ignored local asset directories read-only.
BNG_PROXY_LOCAL_ROOT=/opt/bng-game-assets
BNG_COSMETIC_LOCAL_ROOT=/opt/zeta-cosmetic-assets
